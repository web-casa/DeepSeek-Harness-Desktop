# npm ≥11.17 blocks install scripts unless allowlisted. These five carry the
# builds that make the bundled runtime work: node-pty (agent terminal,
# prebuild copy on Windows), koffi (FFI), dsh-subprocess-local (spawn-helper
# exec bit), protobufjs/@google/genai (harmless, kept explicit for clarity).
allow-scripts[]=node-pty
allow-scripts[]=koffi
allow-scripts[]=@deepseek-ai/dsh-subprocess-local
allow-scripts[]=protobufjs
allow-scripts[]=@google/genai
