# npm ≥11.17 script policy. These five carry the builds that make the bundled
# runtime work: node-pty (agent terminal, prebuild copy on Windows), koffi
# (FFI), dsh-subprocess-local (spawn-helper exec bit), protobufjs/@google/genai
# (harmless, kept explicit for clarity). strict-allow-scripts turns the list
# into a real allowlist: any OTHER package adding an install script makes
# `npm ci` fail loudly instead of running unreviewed.
allow-scripts[]=node-pty
allow-scripts[]=koffi
allow-scripts[]=@deepseek-ai/dsh-subprocess-local
allow-scripts[]=protobufjs
allow-scripts[]=@google/genai
strict-allow-scripts=true
