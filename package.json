{
  "name": "deepseek-harness-desktop",
  "private": true,
  "version": "0.2.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "check:scripts": "tsc -p tsconfig.scripts.json",
    "tauri": "tauri",
    "runtime:node": "node scripts/download-node.ts",
    "runtime:node:generate": "node scripts/generate-node-distribution.ts",
    "runtime:harness": "node scripts/prepare-harness.ts",
    "runtime:sidecar": "node scripts/build-sidecar.ts",
    "runtime:all": "node scripts/download-node.ts && node scripts/prepare-harness.ts && node scripts/build-sidecar.ts",
    "runtime:verify": "node scripts/verify-runtime.ts",
    "release:preflight": "node scripts/release-preflight.ts",
    "icons": "node scripts/gen-icon.ts && tauri icon src-tauri/icons/icon-source.png --output src-tauri/icons",
    "test:scripts": "node --test \"scripts/lib/*.test.ts\"",
    "verify:command-contract": "node scripts/verify-command-contract.ts",
    "verify:cordis-preset": "node scripts/verify-cordis-preset-download.ts",
    "verify:cordis-market": "node scripts/verify-cordis-market-api.ts",
    "tauri:windows:build": "tauri-windows-bundle build --runner pnpm",
    "verify:sideload": "node scripts/verify-sideload.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "@choochmeque/tauri-windows-bundle": "^0.1.28"
  },
  "packageManager": "pnpm@11.21.0"
}
