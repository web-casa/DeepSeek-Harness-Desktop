# Node
node_modules/

# Frontend build
dist/

# Rust build outputs
target/
src-tauri/target/
crates/dsh-sidecar/target/

# tauri-build generated schemas & ACL permissions (regenerated on build)
src-tauri/gen/
src-tauri/permissions/autogenerated/

# Generated runtime (rebuild with pnpm runtime:all)
src-tauri/resources/runtime/

# Icon platform sets generated by `tauri icon` are committed (CI needs them);
# only the mobile folders are noise.
src-tauri/icons/android/
src-tauri/icons/ios/

# pnpm store + script scratch
.pnpm-store/
.tmp/

# Local updater-manifest artifact (scripts/updater-manifest.ts); the live
# one is published by CI and must never be committed from a local run.
latest.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log
