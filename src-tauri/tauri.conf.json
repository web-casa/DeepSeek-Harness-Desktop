{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.2.6",
  "identifier": "com.yeagoo.dsh-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "bootstrap",
        "title": "DeepSeek Harness",
        "width": 560,
        "height": 700,
        "minWidth": 480,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness as a native desktop app",
    "longDescription": "Community desktop packaging of DeepSeek Harness: a bundled Node runtime and the official Harness Web UI inside a native shell. The Harness runtime is pinned via runtime-manifest.json; nothing is forked.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/runtime": "runtime"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCRDlCQTgxQTMyRjBGMEYKUldRUER5K2pnYnJadS9JVll3RVI1c2JTY0ZGK2NNZjlqOXhKcS96QjJYODdraFdmVmdBNjM0NEIK",
      "endpoints": [
        "https://github.com/web-casa/DeepSeek-Harness-Desktop/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "dsharness"
        ]
      }
    }
  }
}
