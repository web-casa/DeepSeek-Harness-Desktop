{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bootstrap",
  "description": "Trusted local bootstrap/settings UI. Core defaults plus the app's own commands (gated by the app ACL generated in build.rs).",
  "windows": [
    "bootstrap"
  ],
  "permissions": [
    "core:default",
    "allow-get-status",
    "allow-get-logs",
    "allow-get-versions",
    "allow-get-diagnostics",
    "allow-restart",
    "allow-shutdown",
    "allow-open-harness",
    "allow-check-update",
    "allow-install-update-and-restart",
    "allow-export-diagnostics",
    "allow-quit-app",
    "dialog:allow-save",
    "opener:allow-open-url",
    "allow-list-user-presets",
    "allow-preview-preset",
    "allow-import-preset",
    "allow-export-preset"
  ]
}
