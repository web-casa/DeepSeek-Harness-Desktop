{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bootstrap",
  "description": "Trusted local bootstrap/settings UI. Core defaults plus the app's own commands (gated by the app ACL generated in build.rs).",
  "windows": [
    "bootstrap"
  ],
  "permissions": [
    "core:default",
    "allow-get-status",
    "allow-get-logs",
    "allow-get-versions",
    "allow-get-diagnostics",
    "allow-restart",
    "allow-shutdown",
    "allow-open-harness",
    "allow-check-update",
    "allow-install-update-and-restart",
    "allow-export-diagnostics",
    "allow-quit-app",
    "dialog:allow-save",
    "opener:allow-open-url",
    "allow-list-user-presets",
    "allow-preview-preset",
    "allow-import-preset",
    "allow-export-preset",
    "allow-delete-preset",
    "allow-list-plugins",
    "allow-install-plugin",
    "allow-uninstall-plugin",
    "allow-cancel-plugin-op",
    "allow-get-pending-plugin-install",
    "allow-dismiss-pending-plugin-install",
    "allow-get-pending-remote-preset",
    "allow-dismiss-remote-preset",
    "allow-confirm-remote-preset-download",
    "allow-import-remote-preset",
    "allow-cancel-preset-preview",
    "dialog:allow-open",
    "allow-market-search",
    "allow-market-plugin",
    "allow-market-image",
    "allow-sideload-plugin",
    "allow-pick-sideload-file"
  ]
}
